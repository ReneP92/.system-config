#!/usr/bin/env bash
set -euo pipefail

GSTACK_DIR="$HOME/.claude/skills/gstack"
GSTACK_URL="https://github.com/garrytan/gstack.git"

for tool in git bun; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Error: $tool is required to install gstack. Run ./bootstrap.sh to install dependencies." >&2
    exit 1
  fi
done

if [ -e "$GSTACK_DIR" ] || [ -L "$GSTACK_DIR" ]; then
  origin="$(git -C "$GSTACK_DIR" remote get-url origin 2>/dev/null || true)"
  if [ "$origin" != "$GSTACK_URL" ] || [ ! -x "$GSTACK_DIR/setup" ]; then
    echo "Error: $GSTACK_DIR is not the expected gstack checkout; inspect it before continuing." >&2
    exit 1
  fi
else
  mkdir -p "$(dirname "$GSTACK_DIR")"
  git clone --single-branch --depth 1 "$GSTACK_URL" "$GSTACK_DIR"
fi

# Re-run upstream setup to repair registrations and build missing tools.
# Updates are explicit via /gstack-upgrade; bootstrap keeps the current checkout.
# Closed stdin lets upstream use its noninteractive defaults for optional hooks.
cd "$GSTACK_DIR"
./setup --host claude --prefix </dev/null
./setup --host opencode </dev/null
# Upstream --status currently misreads the conditional ../qa reference in
# prefixed Claude installs. The doctor checks the installed tools and hooks.
./bin/gstack-doctor
