#!/usr/bin/env bash
# System-wide theme switcher for wezterm, tmux, nvim, fzf, Claude Code, and
# the macOS wallpaper.
#
#   theme                   print the current theme
#   theme <name>            switch (rose-pine | nightowl | tokyonight), with a
#                           translucent background (the wallpaper shows through)
#   theme <name> opaque     switch with solid backgrounds instead
#
# State lives in ~/.config/theme/current (theme name) and
# ~/.config/theme/background (transparent | opaque); each app reads them:
#   - wezterm watches the file and recolors open windows immediately
#   - tmux sources ~/.config/theme/tmux-current.conf (symlink set here)
#   - nvim reads it on startup (running instances keep their theme)
#   - fzf colors are set by .zshrc (new shells)
#   - Claude Code uses the custom theme ~/.claude/themes/active.json, copied
#     here from assets/claude-themes/ (running sessions hot-reload it)
#   - macOS uses the matching bundled wallpaper
set -euo pipefail

STATE_DIR="$HOME/.config/theme"
# ~/.scripts/theme is a symlink into the repo; resolve it to read the tmux
# palettes, wallpapers and Claude themes straight from the repo, so a newly
# added theme works without re-running bootstrap.sh to link its files
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/.tmux/themes"
WALLPAPERS_DIR="$REPO_DIR/assets/wallpapers"
CLAUDE_THEMES_DIR="$REPO_DIR/assets/claude-themes"
CLAUDE_ACTIVE="$HOME/.claude/themes/active.json"

current() {
  local name background
  name="$(cat "$STATE_DIR/current" 2>/dev/null || echo "rose-pine (default)")"
  background="$(cat "$STATE_DIR/background" 2>/dev/null || echo transparent)"
  if [ "$background" = opaque ]; then
    echo "$name (opaque)"
  else
    echo "$name"
  fi
}

usage() {
  echo "usage: theme [<name> [opaque]]" >&2
  exit 1
}

if [ $# -eq 0 ]; then
  current
  exit 0
fi
[ $# -le 2 ] || usage

name="$1"
background=transparent
if [ $# -eq 2 ]; then
  [ "$2" = opaque ] || usage
  background=opaque
fi
if [ ! -r "$THEMES_DIR/$name.conf" ]; then
  echo "unknown theme: $name" >&2
  echo "available: $(cd "$THEMES_DIR" && ls ./*.conf | sed 's|^\./||; s|\.conf$||' | paste -sd ' ' -)" >&2
  exit 1
fi

claude_theme="$CLAUDE_THEMES_DIR/$name.json"
if [ ! -r "$claude_theme" ]; then
  echo "Claude Code theme not found: $claude_theme" >&2
  exit 1
fi

if [ "$(uname -s)" = "Darwin" ]; then
  wallpaper="$WALLPAPERS_DIR/$name-dark-wallpaper-2560x1440.png"
  if [ ! -r "$wallpaper" ]; then
    echo "wallpaper not found: $wallpaper" >&2
    exit 1
  fi

  osascript - "$wallpaper" <<'APPLESCRIPT'
on run argv
  tell application "System Events"
    set picture of every desktop to item 1 of argv
  end tell
end run
APPLESCRIPT
fi

mkdir -p "$STATE_DIR"
printf '%s\n' "$name" > "$STATE_DIR/current"
printf '%s\n' "$background" > "$STATE_DIR/background"
ln -sf "$THEMES_DIR/$name.conf" "$STATE_DIR/tmux-current.conf"

# write via a temp file + rename so Claude Code's watcher never reads a
# half-written theme
mkdir -p "$(dirname "$CLAUDE_ACTIVE")"
cp "$claude_theme" "$CLAUDE_ACTIVE.tmp"
mv "$CLAUDE_ACTIVE.tmp" "$CLAUDE_ACTIVE"

if [ -n "${TMUX:-}" ] || tmux info >/dev/null 2>&1; then
  tmux source-file ~/.tmux.conf
fi

# nudge wezterm's config watcher so open windows recolor (the state file
# itself isn't reliably watched; the main config file always is)
touch ~/.wezterm.lua 2>/dev/null || true

echo "theme: $(current) (nvim picks it up on next launch)"
